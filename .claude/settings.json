{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform init:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform show:*)",
      "Bash(terraform output:*)",
      "Bash(tofu fmt:*)",
      "Bash(tofu validate:*)",
      "Bash(tofu init:*)",
      "Bash(tofu plan:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(node --check:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(bash -n:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(aws:*)",
      "Bash(curl:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(terraform taint:*)",
      "Bash(terraform force-unlock:*)",
      "Bash(tofu apply:*)",
      "Bash(tofu destroy:*)",
      "Bash(tofu import:*)",
      "Bash(tofu state:*)",
      "Bash(aws iam:*)",
      "Bash(aws organizations:*)",
      "Bash(aws ssm put-parameter:*)",
      "Bash(aws secretsmanager:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.*)",
      "Read(./**/terraform.tfvars)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)"
    ]
  }
}
