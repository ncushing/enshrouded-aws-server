[Unit]
Description=Enshrouded server stack (docker compose)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
RequiresMountsFor=/mnt/data

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/local/bin/enshrouded-sync.sh
ExecStart=/usr/bin/docker compose -f /opt/enshrouded-ctl/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f /opt/enshrouded-ctl/docker-compose.yml stop -t 90
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
